{
  "name": "cube-explorer",
  "type": "module",
  "version": "0.5.2",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest --config vitest.e2e.config.ts run",
    "test:e2e:watch": "pnpm build && vitest --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.11.0",
    "@biomejs/biome": "2.5.4",
    "@crxjs/vite-plugin": "^2.7.1",
    "@cubejs-client/core": "^1.7.2",
    "@tailwindcss/language-server": "0.14.29",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.1.10",
    "vitest-environment-web-ext": "0.0.3"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.0.0"
  }
}
